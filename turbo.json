{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_ANON_KEY",
        "ANTHROPIC_API_KEY",
        "SPIKE_PASSCODE"
      ]
    },
    "test": { "dependsOn": ["^build"], "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "persistent": true, "cache": false },
    "clean": { "cache": false }
  }
}
